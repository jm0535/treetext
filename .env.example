# TreeText Environment Configuration

# API Configuration
VITE_API_BASE_URL=http://localhost:3000
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# Auth0 Configuration (Required)
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# External API Keys (Move to backend for production)
VITE_OPENAI_API_KEY=your-openai-api-key
VITE_COHERE_API_KEY=your-cohere-api-key
VITE_HUGGINGFACE_API_KEY=your-huggingface-api-key

# Feature Flags
VITE_FEATURE_EXPORT=true
VITE_FEATURE_REAL_TIME=false
VITE_FEATURE_AUTH=true
VITE_FEATURE_HISTORY=true

# Application Metadata
VITE_APP_VERSION=1.0.0
