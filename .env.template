# OAuth Client IDs for cloud storage services
# Copy this file to .env.local and fill in your actual credentials

# Google Drive OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Dropbox OAuth
NEXT_PUBLIC_DROPBOX_CLIENT_ID=your-dropbox-app-key

# OneDrive OAuth
NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=your-microsoft-client-id
