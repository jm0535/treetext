generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  auth0Id   String   @unique
  email     String   @unique
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  textAnalyses TextAnalysisHistory[]
  fileAnalyses FileUploadHistory[]
}

model TextAnalysisHistory {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [auth0Id])
  textContent      String   @db.Text
  title            String?
  plagiarismScore  Float?
  grammarScore     Float?
  readabilityScore Float?
  analysisSettings Json?
  results          Json?
  createdAt        DateTime @default(now())

  @@index([userId])
}

model FileUploadHistory {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [auth0Id])
  fileName         String
  fileType         String
  fileSize         Int
  fileContent      String?  @db.Text
  fileUrl          String?
  plagiarismScore  Float?
  grammarScore     Float?
  readabilityScore Float?
  analysisSettings Json?
  results          Json?
  createdAt        DateTime @default(now())

  @@index([userId])
}
